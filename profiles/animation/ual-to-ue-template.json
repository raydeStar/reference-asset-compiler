                  "MF_Unarmed_Jog_Bwd", "MF_Unarmed_Jog_Bwd_Left", "MF_Unarmed_Jog_Bwd_Right"]},
    "MF_Unarmed_Sprint_Fwd": {"library": "ual1", "action": "Sprint_Loop", "loop": true, "measure_speed": true},
